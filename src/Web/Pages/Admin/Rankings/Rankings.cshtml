@page "/Admin/Rankings"
@model BldLeague.Web.Pages.Admin.Rankings.Rankings

<div class="container mt-2">
    <h2>Rankingi</h2>
    <form method="post" asp-page-handler="RefreshRankings">
        <button type="submit" class="btn btn-secondary">
            Odśwież rankingi
        </button>
    </form>
    <form method="post" asp-page-handler="RefreshRecords" class="mt-2">
        <button type="submit" class="btn btn-secondary">
            Odśwież rekordy (PR/rekordy strony)
        </button>
    </form>
</div>
