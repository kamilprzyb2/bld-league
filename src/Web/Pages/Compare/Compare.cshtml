@page "/Compare"
@using System.Globalization
@using System.Text.Json
@using BldLeague.Application.Common
@using BldLeague.Domain.ValueObjects
@using BldLeague.Web.ViewModels
@model BldLeague.Web.Pages.Compare.Compare

<div class="container mt-2">
    @if (Model.Comparison == null)
    {
        <h2>Porównanie zawodników</h2>

        if (Model.ErrorMessage != null)
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        <p class="text-muted">Wybierz dwóch zawodników, aby zobaczyć ich bezpośrednie porównanie.</p>

        var playerAPrefill = Model.AllUsers.FirstOrDefault(u => u.Id == Model.UserAId) is { } knownUserA
            ? $"{knownUserA.FullName} ({knownUserA.WcaId})"
            : Model.PlayerA;
        var opponentPrefill = Model.AllUsers.FirstOrDefault(u => u.Id == Model.UserBId) is { } knownUserB
            ? $"{knownUserB.FullName} ({knownUserB.WcaId})"
            : Model.Opponent;

        <form method="get" class="row g-2">
            <div class="col-12 col-md-5">
                <input list="allPlayers" name="PlayerA" class="form-control" placeholder="Zawodnik A" value="@playerAPrefill" />
            </div>
            <div class="col-12 col-md-5">
                <input list="allPlayers" name="Opponent" class="form-control" placeholder="Zawodnik B" value="@opponentPrefill" />
            </div>
            <div class="col-12 col-md-2">
                <button type="submit" class="btn btn-primary w-100">Porównaj</button>
            </div>
            <datalist id="allPlayers">
                @foreach (var pickerUser in Model.AllUsers)
                {
                    <option value="@($"{pickerUser.FullName} ({pickerUser.WcaId})")"></option>
                }
            </datalist>
        </form>
    }
    else
    {
        var comparison = Model.Comparison;
        var playerA = comparison.PlayerA;
        var playerB = comparison.PlayerB;

        @* 1. Versus banner *@
        <div class="row text-center align-items-center mb-4 mt-3">
            <div class="col-4 col-md-5">
                @if (playerA.AvatarThumbnailUrl != null)
                {
                    <img src="@playerA.AvatarThumbnailUrl" alt="Avatar" class="mb-2 rounded" style="max-width:100px;height:auto;" />
                }
                else
                {
                    <i class="bi bi-person-circle" style="font-size:4rem;"></i>
                }
                <h4 class="mb-1"><a asp-page="/Users/UserProfile" asp-route-id="@playerA.UserId">@playerA.FullName</a></h4>
                <div class="text-muted">@playerA.WcaId</div>
            </div>
            <div class="col-4 col-md-2">
                <div class="display-6 fw-bold text-nowrap">@comparison.WinsA : @comparison.WinsB</div>
                <div class="text-muted small">Remisy: @comparison.Draws</div>
                <a class="small" asp-page="/Compare/Compare"
                   asp-route-userAId="@playerB.UserId" asp-route-userBId="@playerA.UserId">
                    <i class="bi bi-arrow-left-right"></i> Zamień strony
                </a>
            </div>
            <div class="col-4 col-md-5">
                @if (playerB.AvatarThumbnailUrl != null)
                {
                    <img src="@playerB.AvatarThumbnailUrl" alt="Avatar" class="mb-2 rounded" style="max-width:100px;height:auto;" />
                }
                else
                {
                    <i class="bi bi-person-circle" style="font-size:4rem;"></i>
                }
                <h4 class="mb-1"><a asp-page="/Users/UserProfile" asp-route-id="@playerB.UserId">@playerB.FullName</a></h4>
                <div class="text-muted">@playerB.WcaId</div>
            </div>
        </div>

        @* 2. Upcoming meeting *@
        if (comparison.UpcomingMeeting != null)
        {
            var upcoming = comparison.UpcomingMeeting;
            <div class="alert alert-info d-flex align-items-center gap-2 flex-wrap">
                <strong>Nadchodzący mecz:</strong>
                <span>Sezon @upcoming.SeasonNumber, Kolejka @upcoming.RoundNumber, Liga @upcoming.LeagueIdentifier</span>
                @if (upcoming.IsInProgress)
                {
                    <span class="badge text-bg-warning">W trakcie</span>
                }
                else
                {
                    <span class="badge text-bg-secondary">Planowany</span>
                }
            </div>
        }

        @* 3. Direct record *@
        <h4>Bilans bezpośredni</h4>
        if (!comparison.Meetings.Any())
        {
            <p class="mb-4">Ci zawodnicy nie grali jeszcze ze sobą.</p>
        }
        else
        {
            var meetingsCount = comparison.Meetings.Count;
            var winsAWidth = (100.0 * comparison.WinsA / meetingsCount).ToString("0.##", CultureInfo.InvariantCulture);
            var drawsWidth = (100.0 * comparison.Draws / meetingsCount).ToString("0.##", CultureInfo.InvariantCulture);
            var winsBWidth = (100.0 * comparison.WinsB / meetingsCount).ToString("0.##", CultureInfo.InvariantCulture);
            var biggestWin = comparison.Meetings
                .Where(m => m.ScoreA != m.ScoreB)
                .OrderByDescending(m => Math.Abs(m.ScoreA - m.ScoreB))
                .FirstOrDefault();

            <div class="progress mb-3" style="height:1.5rem;">
                @if (comparison.WinsA > 0)
                {
                    <div class="progress-bar bg-success" role="progressbar" style="width:@(winsAWidth)%">@comparison.WinsA</div>
                }
                @if (comparison.Draws > 0)
                {
                    <div class="progress-bar bg-secondary" role="progressbar" style="width:@(drawsWidth)%">@comparison.Draws</div>
                }
                @if (comparison.WinsB > 0)
                {
                    <div class="progress-bar bg-danger" role="progressbar" style="width:@(winsBWidth)%">@comparison.WinsB</div>
                }
            </div>
            <table class="table table-sm mb-4" style="max-width:480px;">
                <tbody>
                <tr>
                    <td>Rozegrane mecze</td>
                    <td class="text-end fw-semibold">@meetingsCount</td>
                </tr>
                <tr>
                    <td>Suma punktów</td>
                    <td class="text-end fw-semibold">@comparison.SolvePointsA : @comparison.SolvePointsB</td>
                </tr>
                <tr>
                    <td>Największa wygrana</td>
                    <td class="text-end fw-semibold">
                        @if (biggestWin == null)
                        {
                            <span>–</span>
                        }
                        else
                        {
                            var winnerName = biggestWin.ScoreA > biggestWin.ScoreB ? playerA.FullName : playerB.FullName;
                            var winnerScore = Math.Max(biggestWin.ScoreA, biggestWin.ScoreB);
                            var loserScore = Math.Min(biggestWin.ScoreA, biggestWin.ScoreB);
                            <span>@winnerName @winnerScore:@loserScore (S@(biggestWin.SeasonNumber) K@(biggestWin.RoundNumber))</span>
                        }
                    </td>
                </tr>
                </tbody>
            </table>
        }

        @* 4. Meetings history *@
        <h4>Historia spotkań</h4>
        if (!comparison.Meetings.Any())
        {
            <p class="mb-4">Brak spotkań.</p>
        }
        else
        {
            <div class="table-responsive mb-4">
                <table class="table table-hover align-middle">
                    <thead>
                    <tr>
                        <th scope="col">Sezon</th>
                        <th scope="col">Kolejka</th>
                        <th scope="col">Liga</th>
                        <th scope="col" class="text-center text-nowrap">Wynik</th>
                        <th scope="col">Szczegóły</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var meeting in comparison.Meetings)
                    {
                        <tr>
                            <td>@meeting.SeasonNumber</td>
                            <td>@meeting.RoundNumber</td>
                            <td>@meeting.LeagueIdentifier</td>
                            <td class="text-center text-nowrap">
                                <span class="@(meeting.ScoreA > meeting.ScoreB ? "fw-bold" : "")">@meeting.ScoreA</span>
                                <span>:</span>
                                <span class="@(meeting.ScoreB > meeting.ScoreA ? "fw-bold" : "")">@meeting.ScoreB</span>
                            </td>
                            <td>
                                <a class="btn btn-sm btn-primary" asp-page="/Matches/ViewMatch" asp-route-id="@meeting.MatchId">Zobacz</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        @* 5. Stats comparison *@
        <h4>Porównanie statystyk</h4>
        var statsA = playerA.Stats;
        var statsB = playerB.Stats;
        var matchesPlayedA = statsA.Wins + statsA.Losses + statsA.Draws;
        var matchesPlayedB = statsB.Wins + statsB.Losses + statsB.Draws;

        var comparisonRows = new List<ComparisonRowViewModel>
        {
            new("Rekord single",
                FormatRecord(playerA.BestSingle, playerA.SingleRank),
                FormatRecord(playerB.BestSingle, playerB.SingleRank),
                IsLowerBetter(ValidCentiseconds(playerA.BestSingle), ValidCentiseconds(playerB.BestSingle)),
                IsLowerBetter(ValidCentiseconds(playerB.BestSingle), ValidCentiseconds(playerA.BestSingle))),
            new("Rekord average",
                FormatRecord(playerA.BestAverage, playerA.AverageRank),
                FormatRecord(playerB.BestAverage, playerB.AverageRank),
                IsLowerBetter(ValidCentiseconds(playerA.BestAverage), ValidCentiseconds(playerB.BestAverage)),
                IsLowerBetter(ValidCentiseconds(playerB.BestAverage), ValidCentiseconds(playerA.BestAverage))),
            new("Średni czas",
                statsA.AverageSingle?.ToString() ?? "–",
                statsB.AverageSingle?.ToString() ?? "–",
                IsLowerBetter(ValidCentiseconds(statsA.AverageSingle), ValidCentiseconds(statsB.AverageSingle)),
                IsLowerBetter(ValidCentiseconds(statsB.AverageSingle), ValidCentiseconds(statsA.AverageSingle))),
            new("Skuteczność",
                FormatEffectiveness(statsA),
                FormatEffectiveness(statsB),
                IsHigherBetter(EffectivenessPercent(statsA), EffectivenessPercent(statsB)),
                IsHigherBetter(EffectivenessPercent(statsB), EffectivenessPercent(statsA))),
            new("Rozegrane mecze",
                matchesPlayedA.ToString(),
                matchesPlayedB.ToString(),
                IsHigherBetter(matchesPlayedA, matchesPlayedB),
                IsHigherBetter(matchesPlayedB, matchesPlayedA)),
            new("Bilans W/R/P",
                $"{statsA.Wins}/{statsA.Draws}/{statsA.Losses}",
                $"{statsB.Wins}/{statsB.Draws}/{statsB.Losses}",
                IsHigherBetter(statsA.Wins, statsB.Wins),
                IsHigherBetter(statsB.Wins, statsA.Wins)),
            new("Najlepsza passa zwycięstw",
                statsA.LongestWinStreak.ToString(),
                statsB.LongestWinStreak.ToString(),
                IsHigherBetter(statsA.LongestWinStreak, statsB.LongestWinStreak),
                IsHigherBetter(statsB.LongestWinStreak, statsA.LongestWinStreak)),
            new("Najwięcej sukcesów z rzędu",
                statsA.LongestSuccessStreak.ToString(),
                statsB.LongestSuccessStreak.ToString(),
                IsHigherBetter(statsA.LongestSuccessStreak, statsB.LongestSuccessStreak),
                IsHigherBetter(statsB.LongestSuccessStreak, statsA.LongestSuccessStreak)),
            new("Liczba sezonów",
                playerA.SeasonsPlayed.ToString(),
                playerB.SeasonsPlayed.ToString(),
                false, false),
            new("Aktualna liga",
                playerA.CurrentLeagueIdentifier ?? "–",
                playerB.CurrentLeagueIdentifier ?? "–",
                false, false),
        };

        <div class="table-responsive mb-4">
            <table class="table align-middle">
                <thead>
                <tr>
                    <th scope="col" class="text-end">@playerA.FullName</th>
                    <th scope="col" class="text-center"></th>
                    <th scope="col">@playerB.FullName</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var comparisonRow in comparisonRows)
                {
                    <partial name="_ComparisonRow" model="comparisonRow" />
                }
                </tbody>
            </table>
        </div>

        @* 6. Recent form *@
        <h4>Forma</h4>
        <div class="row mb-4">
            @foreach (var (formPlayer, formEntries) in new[] { (playerA, playerA.RecentForm), (playerB, playerB.RecentForm) })
            {
                <div class="col-12 col-md-6 mb-2">
                    <div class="fw-semibold mb-1">@formPlayer.FullName</div>
                    @if (!formEntries.Any())
                    {
                        <span class="text-muted">Brak meczów.</span>
                    }
                    else
                    {
                        foreach (var formEntry in formEntries)
                        {
                            var badgeClass = formEntry.Outcome switch
                            {
                                MatchOutcome.Win => "bg-success",
                                MatchOutcome.Draw => "bg-secondary",
                                _ => "bg-danger"
                            };
                            var badgeText = formEntry.Outcome switch
                            {
                                MatchOutcome.Win => "W",
                                MatchOutcome.Draw => "R",
                                _ => "P"
                            };
                            <span class="badge @badgeClass me-1" style="font-size:.9rem;"
                                  title="S@(formEntry.SeasonNumber) K@(formEntry.RoundNumber) — @formEntry.SelfScore:@formEntry.OpponentScore vs @formEntry.OpponentFullName">@badgeText</span>
                        }
                    }
                </div>
            }
        </div>

        @* 7. Common rounds *@
        <h4>Wspólne kolejki</h4>
        if (!comparison.CommonRounds.Any())
        {
            <p class="mb-4">Brak wspólnych kolejek.</p>
        }
        else
        {
            var commonRoundsCount = comparison.CommonRounds.Count;
            <p class="text-muted">
                @if (comparison.CommonRoundWinsA > comparison.CommonRoundWinsB)
                {
                    <span>W @comparison.CommonRoundWinsA z @commonRoundsCount wspólnych kolejek lepszą średnią miał @playerA.FullName.</span>
                }
                else if (comparison.CommonRoundWinsB > comparison.CommonRoundWinsA)
                {
                    <span>W @comparison.CommonRoundWinsB z @commonRoundsCount wspólnych kolejek lepszą średnią miał @playerB.FullName.</span>
                }
                else
                {
                    <span>Obaj zawodnicy mieli lepszą średnią w tej samej liczbie wspólnych kolejek (po @comparison.CommonRoundWinsA z @commonRoundsCount).</span>
                }
            </p>
            <div class="table-responsive mb-4">
                <table class="table table-hover align-middle">
                    <thead>
                    <tr>
                        <th scope="col" rowspan="2" class="align-middle">Kolejka</th>
                        <th scope="col" colspan="3" class="text-center">@playerA.FullName</th>
                        <th scope="col" colspan="3" class="text-center">@playerB.FullName</th>
                        <th scope="col" rowspan="2" class="align-middle text-center">Mecz</th>
                    </tr>
                    <tr>
                        <th scope="col">Liga</th>
                        <th scope="col">Best</th>
                        <th scope="col">Ao5</th>
                        <th scope="col">Liga</th>
                        <th scope="col">Best</th>
                        <th scope="col">Ao5</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var commonRound in comparison.CommonRounds)
                    {
                        var aHasBetterAverage = commonRound.AverageA.IsValid
                            && (!commonRound.AverageB.IsValid || commonRound.AverageA.Centiseconds < commonRound.AverageB.Centiseconds);
                        var bHasBetterAverage = commonRound.AverageB.IsValid
                            && (!commonRound.AverageA.IsValid || commonRound.AverageB.Centiseconds < commonRound.AverageA.Centiseconds);
                        <tr>
                            <td class="text-nowrap">S@(commonRound.SeasonNumber) K@(commonRound.RoundNumber)</td>
                            <td>@commonRound.LeagueIdentifierA</td>
                            <td>@commonRound.BestA.ToSummaryString()</td>
                            <td class="@(aHasBetterAverage ? "fw-bold" : "")">
                                @commonRound.AverageA.ToSummaryString()
                                @if (aHasBetterAverage)
                                {
                                    <i class="bi bi-check-lg text-success" title="Lepsza średnia"></i>
                                }
                            </td>
                            <td>@commonRound.LeagueIdentifierB</td>
                            <td>@commonRound.BestB.ToSummaryString()</td>
                            <td class="@(bHasBetterAverage ? "fw-bold" : "")">
                                @commonRound.AverageB.ToSummaryString()
                                @if (bHasBetterAverage)
                                {
                                    <i class="bi bi-check-lg text-success" title="Lepsza średnia"></i>
                                }
                            </td>
                            <td class="text-center">
                                @if (commonRound.FacedEachOther)
                                {
                                    <i class="bi bi-people-fill" title="Mecz bezpośredni"></i>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        @* 8. Progression chart *@
        <h4>Progresja</h4>
        var chartPointsA = comparison.CommonRounds.Count(c => c.AverageA.IsValid);
        var chartPointsB = comparison.CommonRounds.Count(c => c.AverageB.IsValid);
        if (chartPointsA < 2 || chartPointsB < 2)
        {
            <p class="mb-4">Za mało danych do wyświetlenia wykresu.</p>
        }
        else
        {
            <canvas id="comparisonChart" class="mb-4"></canvas>
        }
    }
</div>

@functions {
    private static string FormatRecord(SolveResult? result, int? rank)
        => result == null
            ? "–"
            : rank == null
                ? result.Value.ToString()
                : $"{result.Value} (#{rank})";

    private static int? ValidCentiseconds(SolveResult? result)
        => result is { IsValid: true } ? result.Value.Centiseconds : null;

    private static string FormatEffectiveness(UserStats stats)
        => stats.NonDnsSolves > 0
            ? $"{stats.ValidSolves}/{stats.NonDnsSolves} ({(int)Math.Round(100.0 * stats.ValidSolves / stats.NonDnsSolves)}%)"
            : "–";

    private static double? EffectivenessPercent(UserStats stats)
        => stats.NonDnsSolves > 0 ? 100.0 * stats.ValidSolves / stats.NonDnsSolves : null;

    private static bool IsLowerBetter(int? value, int? other)
        => value != null && (other == null || value < other);

    private static bool IsHigherBetter(double? value, double? other)
        => value != null && (other == null || value > other);
}

@section Scripts {
    @if (Model.Comparison != null)
    {
        var scriptCommonRounds = Model.Comparison.CommonRounds;
        var scriptRenderChart = scriptCommonRounds.Count(c => c.AverageA.IsValid) >= 2
                                && scriptCommonRounds.Count(c => c.AverageB.IsValid) >= 2;
        if (scriptRenderChart)
        {
            <script src="https://cdn.jsdelivr.net/npm/chart.js@@4"></script>
            <script>
                (function () {
                    var labels = @Html.Raw(JsonSerializer.Serialize(scriptCommonRounds.Select(c => $"S{c.SeasonNumber} K{c.RoundNumber}").ToArray()));
                    var avgValuesA = @Html.Raw(JsonSerializer.Serialize(scriptCommonRounds.Select(c => c.AverageA.IsValid ? (double?)Math.Round(c.AverageA.Centiseconds / 100.0, 2) : null).ToArray()));
                    var avgValuesB = @Html.Raw(JsonSerializer.Serialize(scriptCommonRounds.Select(c => c.AverageB.IsValid ? (double?)Math.Round(c.AverageB.Centiseconds / 100.0, 2) : null).ToArray()));
                    var nameA = @Html.Raw(JsonSerializer.Serialize(Model.Comparison.PlayerA.FullName));
                    var nameB = @Html.Raw(JsonSerializer.Serialize(Model.Comparison.PlayerB.FullName));

                    function fmtSecs(v) {
                        if (v === null || v === undefined) return '–';
                        if (v >= 60) {
                            var m = Math.floor(v / 60);
                            var s = v - m * 60;
                            return m + ':' + (s < 10 ? '0' : '') + s.toFixed(2);
                        }
                        return v.toFixed(2) + 's';
                    }

                    var ctx = document.getElementById('comparisonChart').getContext('2d');
                    new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: labels,
                            datasets: [
                                {
                                    label: nameA,
                                    data: avgValuesA,
                                    borderColor: 'rgb(54, 162, 235)',
                                    backgroundColor: 'rgba(54, 162, 235, 0.1)',
                                    tension: 0.3,
                                    fill: false,
                                    spanGaps: true
                                },
                                {
                                    label: nameB,
                                    data: avgValuesB,
                                    borderColor: 'rgb(255, 99, 132)',
                                    backgroundColor: 'rgba(255, 99, 132, 0.1)',
                                    tension: 0.3,
                                    fill: false,
                                    spanGaps: true
                                }
                            ]
                        },
                        options: {
                            scales: {
                                y: {
                                    ticks: {
                                        callback: function (v) { return fmtSecs(v); }
                                    }
                                }
                            },
                            plugins: {
                                tooltip: {
                                    callbacks: {
                                        label: function (context) {
                                            var val = context.parsed.y;
                                            return context.dataset.label + ': ' + fmtSecs(val);
                                        }
                                    }
                                }
                            }
                        }
                    });
                })();
            </script>
        }
    }
}
